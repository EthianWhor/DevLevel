# Copiar este archivo como .env y llenar los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Puerto local del servidor (Render pone el suyo automáticamente)
PORT=3000

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret key (o la "service_role" en las llaves antiguas)
# Esta llave se salta RLS: solo puede vivir en el backend, nunca en la app.
SUPABASE_SECRET_KEY=
